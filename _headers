# Hashed build output (CSS, JS, self-hosted fonts) — safe to pin forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images for 6 months
/*.jpg
  Cache-Control: public, max-age=15552000, immutable

/*.png
  Cache-Control: public, max-age=15552000, immutable

/*.gif
  Cache-Control: public, max-age=15552000, immutable

/*.svg
  Cache-Control: public, max-age=15552000, immutable

/*.webp
  Cache-Control: public, max-age=15552000, immutable

