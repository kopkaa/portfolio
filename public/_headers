# Lives in public/ so it lands in dist/ — Netlify only reads _headers from the
# publish directory.

# Hashed build output (CSS, JS, self-hosted fonts) — safe to pin forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed paths: an asset replaced under the same name must reach returning
# visitors, so no `immutable` — cache for a week, then revalidate in background.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
