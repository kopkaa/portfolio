---
// One column on mobile, two from 50em, four from 75em.
// The former `offset` and `small` variants were never used, so the variant
// prop went with them.
---

<ul class="grid">
  <slot />
</ul>

<style>
  .grid {
    display: grid;
    grid-auto-rows: 1fr;
    grid-template-columns: 1fr;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  @media (min-width: 50em) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (min-width: 75em) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
