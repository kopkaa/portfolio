---
import { Font } from "astro:assets";

import "../../styles/global.css";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  ogImage?: string | undefined;
  ogType?: string | undefined;
  noindex?: boolean | undefined;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | undefined;
}

/** Social preview card, 1200x630. Source: scripts/og-template.html */
const OG_FALLBACK = "/og-default.png";
const OG_FALLBACK_SIZE = { width: 1200, height: 630 };

const {
  title = "Jan Hromádka — Full-Stack Web Developer",
  description = "Personal portfolio of Jan Hromádka, a full-stack web developer based in Ostrava, Czechia. Vue, Nuxt, Node.js, Kotlin, AWS, Terraform.",
  ogImage = OG_FALLBACK,
  ogType = "website",
  noindex = false,
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://jhromadka.dev");
const canonical = new URL(Astro.url.pathname, siteUrl);

// Safety net: Facebook, LinkedIn and X all refuse to render SVG previews,
// so an SVG passed in here falls back to the generic card.
const resolvedOgImage = ogImage.endsWith(".svg") ? OG_FALLBACK : ogImage;
const ogImageUrl = new URL(resolvedOgImage, siteUrl);
// Only declared for the fallback, whose dimensions we actually know; a wrong
// width/height hint is worse than none, since scrapers trust it over the file.
const ogSize = resolvedOgImage === OG_FALLBACK ? OG_FALLBACK_SIZE : null;

const defaultJsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Jan Hromádka",
    url: siteUrl.href,
    image: new URL("/assets/me.jpg", siteUrl).href,
    jobTitle: "Full-Stack Web Developer",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Ostrava",
      addressCountry: "CZ",
    },
    email: "mailto:jan.hromadka@outlook.com",
    sameAs: [
      "https://www.linkedin.com/in/jan-hrom%C3%A1dka-ba3820197/",
      "https://github.com/kopkaa",
      "https://codepen.io/kopkaa",
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "jhromadka.dev",
    url: siteUrl.href,
  },
];

const extraLd = jsonLd === undefined ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const ldList = [...defaultJsonLd, ...extraLd];
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Jan Hromádka" />
{noindex && <meta name="robots" content="noindex, follow" />}
<link rel="canonical" href={canonical.href} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="jhromadka.dev" />
<meta property="og:locale" content="en_US" />
<meta property="og:url" content={canonical.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl.href} />
<meta property="og:image:alt" content={`${title} — preview`} />
{ogSize && <meta property="og:image:width" content={String(ogSize.width)} />}
{ogSize && <meta property="og:image:height" content={String(ogSize.height)} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl.href} />
<meta name="twitter:image:alt" content={`${title} — preview`} />

<meta name="theme-color" content="#090b11" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/icon.png" />

<!-- The hero background is the LCP element on mobile, but it's a CSS
     background behind a custom property, so the preload scanner can't see it.
     Mirrors --bg-image-main in BaseLayout; the theme is pinned to dark, so
     only the dark variants are hinted. -->
<link rel="preload" as="image" fetchpriority="high" href="/assets/backgrounds/bg-main-dark-800w.jpg" media="(max-width: 49.99em)" />
<link rel="preload" as="image" fetchpriority="high" href="/assets/backgrounds/bg-main-dark-1440w.jpg" media="(min-width: 50em)" />

<!-- Public Sans is the body face and paints above the fold, so it preloads —
     but only the upright latin file. It's a variable font (400 and 700 share
     it); italic and latin-ext still load on demand via unicode-range.
     Rubik only appears on /projects, so it loads normally. -->
<Font cssVariable="--font-public-sans" preload={[{ style: "normal", subset: "latin" }]} />
<Font cssVariable="--font-rubik" />

{ldList.map((data) => (
  <script type="application/ld+json" set:html={JSON.stringify(data)} />
))}

<script is:inline>
  // This code is inlined in the head to make dark mode instant & blocking.
  const getThemePreference = () => {
    return "dark";
    // if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
    //   return localStorage.getItem('theme');
    // }
    // return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("theme-dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("theme-dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>
