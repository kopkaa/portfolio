---
import FooterNav from "./FooterNav.astro";
import SocialLinks from "../cards/SocialLinks.astro";
---

<footer
  class="footer relative overflow-hidden border-t border-gray-800"
  id="contact"
>
  <div class="flex flex-col">
    <div
      class="py-20 grid grid-cols-1 gap-10 md:py-[120px] md:gap-20 xl:grid-cols-2 xl:py-25 justify-items-center px-6 md:px-0"
    >
      <div
        class="hidden md:grid gap-7.5 justify-items-start content-end md:gap-10 md:py-7.5 md:-my-7.5 xl:gap-12.5"
      >
        <FooterNav />
      </div>

      <div
        class="grid gap-7.5 justify-items-start content-start py-5 -my-5 md:gap-10 md:py-7.5 md:-my-7.5"
        id="kontakt"
      >
        <picture class="portrait-glow">
          <img
            width="400"
            height="379"
            src="/assets/me-cutout.webp"
            alt="Jan Hromádka - front-end developer"
            decoding="async"
            loading="lazy"
            class="portrait block shrink-0 object-cover size-[70px] md:size-25 md:mb-0 mb-4"
          />
        </picture>

        <div class="grid gap-2.5 place-items-start min-w-0 md:mb-0 mb-6">
          <a
            href="mailto:jan.hromadka@outlook.com"
            class="block group relative leading-none font-semibold transition !text-purple-300 md:text-4xl text-lg"
          >
            jan.hromadka@outlook.com <span
              class="block absolute inset-x-0 -bottom-1 h-0.5 bg-current transition-transform duration-300 scale-x-0 origin-right group-hover:scale-x-100 group-hover:origin-left"
            ></span>
          </a>
          <a
            href="tel:+420702512072"
            class="block group relative leading-none font-semibold transition md:text-3xl text-lg"
          >
            (+420) 702&nbsp;512&nbsp;072 <span
              class="block absolute inset-x-0 -bottom-1 h-0.5 bg-current transition-transform duration-300 scale-x-0 origin-right group-hover:scale-x-100 group-hover:origin-left"
            ></span>
          </a>
        </div>

        <div class="ml-0 flex flex-col flex-wrap">
          <SocialLinks />
        </div>
      </div>
    </div>

    <div
      class="md:pl-11 border-t border-gray-800 py-10 xl:gap-12.5 xl:py-7.5"
    >
      <p class="text-gray-400 text-center md:text-left">
        Made with ❤️ by Jan Hromádka
      </p>
    </div>
  </div>
</footer>
<style scoped>
  a {
    color: white;
  }

  /* Cutout with no frame: an elliptical mask dissolves the shirt (bottom and
     the straight crop edges at the shoulders) into the footer instead of
     ending on an edge; a soft accent rim light (drop-shadow follows the
     alpha outline) separates the silhouette from the dark background. */
  .portrait {
    mask-image: radial-gradient(ellipse 62% 78% at 50% 32%, #000 62%, transparent 100%);
  }
  /* On the parent so the glow traces the already-faded silhouette and is not
     clipped by the img box (mask-image clips the element's own filter). */
  .portrait-glow {
    filter: drop-shadow(0 0 6px rgb(175 67 190 / 0.55));
  }
</style>
